# Local platform
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Local PostgreSQL (Docker Compose defaults)
POSTGRES_DB=sports_value
POSTGRES_USER=sports_value
POSTGRES_PASSWORD=local_only_change_me
DATABASE_URL=postgresql://sports_value:local_only_change_me@localhost:5434/sports_value

# Local Redis (reserved for queues and cache)
REDIS_URL=redis://localhost:6379

# API-Football (API-Sports). Server-side only; never prefix with NEXT_PUBLIC_.
# Free account: https://dashboard.api-football.com/register
API_FOOTBALL_KEY=

# The Odds API. Not required for the offline demo.
ODDS_API_KEY=
